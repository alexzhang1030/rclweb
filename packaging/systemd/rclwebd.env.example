# systemd EnvironmentFile for rclwebd.
# This is not a sourced ROS prefix. The ExecStart wrapper sources
# setup.bash so typesupport dlopen and row auto-detect (ADR 0018) work.

# RCLWEBD_ROS_SETUP=/opt/ros/jazzy/setup.bash
# RCLWEBD_BIN=/usr/local/bin/rclwebd

# Process default is 127.0.0.1:8794. Robot-facing services usually bind all
# interfaces. That is still plaintext HTTP/WS — production TLS is a reverse
# proxy, not this file.
# RCLWEBD_BIND=0.0.0.0:8794

# Unset: derive the row from the sourced ROS_DISTRO + RMW_IMPLEMENTATION.
# Do not set a row that disagrees with the sourced prefix.
# RCLWEBD_SUPPORT_ROW=J-FT
# RMW_IMPLEMENTATION=rmw_fastrtps_cpp
# ROS_DOMAIN_ID=0

# Stable id across ordinary restart. Unset = a new instance every start.
# RCLWEBD_GATEWAY_INSTANCE_ID=robot-01

# Auth stays off. Do not set RCLWEBD_AUTH_MODE=oidc until a tenant is named.

# ACL stays off unless you have a policy file.
# RCLWEBD_ACL_MODE=enforce
# RCLWEBD_ACL_PATH=/etc/rclwebd/acl.json

# Intranet / lab WebTransport. Not production PKI.
# RCLWEBD_OFFER_WEBTRANSPORT=1

# Zenoh rows need `ros2 run rmw_zenoh_cpp rmw_zenohd` on tcp/localhost:7447
# before this process starts. This unit does not start the router.
