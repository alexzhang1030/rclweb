[Unit]
Description=rclwebd ROS 2 browser gateway
Documentation=https://github.com/alexzhang1030/rclweb/blob/main/docs/deploy.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-@ENVFILE@
ExecStart=@EXEC@
Restart=on-failure
RestartSec=2
# SIGTERM already drains (default 15s). Stay above that.
TimeoutStopSec=30
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
